# --- Core ---
NODE_ENV=development
PORT=4100
API_BASE_PATH=/api/v1

# MongoDB connection string (Atlas). Use the non-SRV form if your resolver refuses SRV,
# or set DNS_SERVERS=8.8.8.8 to use mongodb+srv://
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017/relaxgo?replicaSet=rs0&tls=true&authSource=admin
DNS_SERVERS=

# --- Auth ---
# Long random strings; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
ADMIN_ORIGIN=http://localhost:3100

# Seeds the first superadmin when the adminusers collection is empty
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Firebase (driver phone auth) ---
# base64 of the service-account JSON: node -e "console.log(Buffer.from(require('fs').readFileSync('sa.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Email (Brevo) ---
BREVO_API_KEY=
EMAIL_FROM_NAME=Relax Go
# Bare address only, no display name
EMAIL_FROM_ADDRESS=

# --- Payments (Razorpay; enable with wallet.paymentGateway=razorpay in admin settings) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File storage (driver documents) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps Platform key (server-side)
GOOGLE_MAPS_API_KEY=
